[
 {
  "id": "c01",
  "k": "정의",
  "q": "평균 변화율의 정의는?",
  "a": "$y=f(x)$에서 $x$가 $a$에서 $a+h$로 변할 때 $\\frac{f(a+h)-f(a)}{h}$. 곡선 위 두 점을 이은 직선의 기울기다.",
  "h": "$\\Delta y/\\Delta x$"
 },
 {
  "id": "c02",
  "k": "정의",
  "q": "극한(lim)이란?",
  "a": "$h$를 0에 한없이 가깝게 할 때($h\\neq0$) 식의 값이 다가가는 일정한 값.",
  "h": "$h=0$을 넣는 것이 아니다. 넣으면 $0/0$"
 },
 {
  "id": "c03",
  "k": "정의",
  "q": "미분계수 $f'(a)$의 정의는?",
  "a": "$f'(a)=\\lim_{h\\to0}\\frac{f(a+h)-f(a)}{h}$. $x=a$에서의 순간 변화율이고 점 $(a, f(a))$에서 접선의 기울기다.",
  "h": "미분계수 = 순간 변화율"
 },
 {
  "id": "c04",
  "k": "정의",
  "q": "도함수와 미분이란?",
  "a": "$x$마다 $f'(x)$를 짝지은 함수가 도함수 $f'(x)=\\frac{dy}{dx}$이고, 도함수를 구하는 것이 미분이다.",
  "h": "미분계수는 한 점의 값, 도함수는 함수"
 },
 {
  "id": "c05",
  "k": "사실",
  "q": "$f(x)=x^2$의 $x=3$에서 미분계수를 극한으로 구하면?",
  "a": "$\\frac{(3+h)^2-9}{h}=\\frac{6h+h^2}{h}=6+h\\to6$. 그래서 $f'(3)=6$.",
  "h": "$h\\neq0$이라 약분할 수 있다."
 },
 {
  "id": "c06",
  "k": "법칙",
  "q": "거듭제곱·상수·상수배·합과 차의 미분 공식은?",
  "a": "$(x^n)'=nx^{n-1}$, $(c)'=0$, $(cf)'=cf'$, $(f\\pm g)'=f'\\pm g'$.",
  "h": "실수 $n$에서도($x>0$) 성립"
 },
 {
  "id": "c07",
  "k": "법칙",
  "q": "곱의 미분과 합성함수의 미분은?",
  "a": "$(fg)'=f'g+fg'$, $\\{f(g(x))\\}'=f'(g(x))g'(x)$.",
  "h": "고교 미적분 과목. $(e^{kx})'=ke^{kx}$도 합성함수의 미분으로 얻는다."
 },
 {
  "id": "c08",
  "k": "사실",
  "q": "$|x|$가 $x=0$에서 미분 가능하지 않은 까닭은?",
  "a": "왼쪽 기울기는 $-1$, 오른쪽 기울기는 $+1$이라 극한이 하나로 정해지지 않는다.",
  "h": "꺾인 점은 확대해도 직선이 되지 않는다."
 },
 {
  "id": "c09",
  "k": "법칙",
  "q": "위치·속도·가속도는 도함수로 어떻게 이어지는가?",
  "a": "$v=dx/dt$, $a=dv/dt$.",
  "h": "단위: m/s, $\\mathrm{m/s^2}$"
 },
 {
  "id": "c10",
  "k": "정의",
  "q": "부정적분과 적분 상수란?",
  "a": "$F'(x)=f(x)$인 $F(x)$가 $f(x)$의 부정적분이고 $\\int f(x)\\,dx=F(x)+C$로 쓴다. $C$가 적분 상수다.",
  "h": "상수는 미분하면 0이라 $C$는 정해지지 않는다."
 },
 {
  "id": "c11",
  "k": "법칙",
  "q": "$\\int x^n\\,dx$와 $\\int x^{-1}dx$는?",
  "a": "$\\int x^n\\,dx=\\frac{x^{n+1}}{n+1}+C$ ($n\\neq-1$), $\\int x^{-1}dx=\\ln|x|+C$.",
  "h": "미분해서 확인한다."
 },
 {
  "id": "c12",
  "k": "정의",
  "q": "정적분 $\\int_a^b f(x)\\,dx$의 정의(누적)는?",
  "a": "$[a, b]$를 $n$등분한 직사각형 넓이 $f(x_k)\\Delta x$의 합에서 $n\\to\\infty$인 극한. $x$축 아래는 음수로 센 넓이다.",
  "h": "고교 수학Ⅱ는 $F(b)-F(a)$를 정의로 쓴다."
 },
 {
  "id": "c13",
  "k": "법칙",
  "q": "미적분의 기본 정리는?",
  "a": "$F'=f$이면 $\\int_a^b f(x)\\,dx=\\Big[F(x)\\Big]_a^b=F(b)-F(a)$.",
  "h": "넓이 함수 $S(x)=\\int_a^x f(t)\\,dt$는 $S'=f$"
 },
 {
  "id": "c14",
  "k": "법칙",
  "q": "변위·속도 변화·이동 거리를 적분으로 쓰면?",
  "a": "$\\Delta x=\\int_{t_1}^{t_2}v\\,dt$, $\\Delta v=\\int_{t_1}^{t_2}a\\,dt$, 이동 거리 $=\\int|v|\\,dt$.",
  "h": "정적분은 부호 있는 넓이"
 },
 {
  "id": "c15",
  "k": "법칙",
  "q": "$a$가 일정할 때 $v=v_0+at$를 적분하면?",
  "a": "$x=x_0+v_0t+\\frac12at^2$. 적분 상수 $x_0$은 처음 위치다.",
  "h": "적분 상수는 처음 조건으로 정한다."
 },
 {
  "id": "c16",
  "k": "정의",
  "q": "자연상수 $e$와 자연로그의 정의는?",
  "a": "$e=\\lim_{h\\to0}(1+h)^{1/h}=2.718\\cdots$. 밑이 $e$인 로그가 자연로그 $\\ln x=\\log_e x$이다.",
  "h": "$\\ln e=1$"
 },
 {
  "id": "c17",
  "k": "법칙",
  "q": "$e^x$, $e^{kx}$, $\\ln x$의 도함수는?",
  "a": "$(e^x)'=e^x$, $(e^{kx})'=ke^{kx}$, $(\\ln x)'=1/x$.",
  "h": ""
 },
 {
  "id": "c18",
  "k": "정의",
  "q": "미분방정식이란?",
  "a": "모르는 함수와 그 도함수의 관계식.",
  "h": "예: $dN/dt=kN$"
 },
 {
  "id": "c19",
  "k": "법칙",
  "q": "$dN/dt=kN$의 해와 푸는 법은?",
  "a": "양변을 $N$으로 나눠 $t$로 적분하면 $\\ln N=kt+C$, 곧 $N=N_0e^{kt}$ ($N_0$은 $t=0$의 값).",
  "h": "변수 분리. $k>0$이면 증가, $k<0$이면 감소"
 },
 {
  "id": "c20",
  "k": "법칙",
  "q": "반감기 $T$와 $k$의 관계는?",
  "a": "$T=\\ln2/|k|\\approx0.693/|k|$. 이때 $e^{kt}=(1/2)^{t/T}$로 49번의 식과 같다.",
  "h": "$k$가 2배면 반감기는 절반"
 },
 {
  "id": "c21",
  "k": "법칙",
  "q": "배가 시간 $T_2$와 $k$의 관계는?",
  "a": "$T_2=\\ln2/k$ ($k>0$). $T_2$마다 2배가 된다.",
  "h": "$N=N_0\\cdot2^{t/T_2}$ (47번)"
 },
 {
  "id": "c22",
  "k": "상수",
  "q": "$\\ln2$와 $e$의 값은?",
  "a": "$\\ln2\\approx0.693$, $e\\approx2.718$.",
  "h": ""
 },
 {
  "id": "c23",
  "k": "상수",
  "q": "¹⁴C(반감기 5730년)의 $|k|$는?",
  "a": "$|k|=\\ln2/(5730\\ \\text{년})=1.21\\times10^{-4}$ /년.",
  "h": "$k$의 단위는 (시간)$^{-1}$"
 },
 {
  "id": "c24",
  "k": "사실",
  "q": "$dN/dt=kN$이 맞는 조건은?",
  "a": "$N$이 커서 매끄러운 함수로 볼 때. 자원이 한정되면 47번의 로지스틱 식을 따르고 $N\\ll K$일 때만 $dN/dt\\approx rN$이다.",
  "h": "원자 하나의 붕괴는 확률(71번)"
 },
 {
  "id": "c25",
  "k": "사실",
  "q": "지수적 감소에서 같은 시간마다 일정한 것은?",
  "a": "줄어드는 비율(배수). 줄어드는 양은 양이 줄수록 작아진다.",
  "h": "반감기마다 절반"
 },
