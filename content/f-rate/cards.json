[
 {
  "id": "c01",
  "k": "정의",
  "q": "평균 변화율의 정의는?",
  "a": "$y=f(x)$에서 $x$가 $a$에서 $a+h$로 변할 때 $\\frac{f(a+h)-f(a)}{h}$. 곡선 위 두 점을 이은 직선의 기울기다.",
  "h": "$\\Delta y/\\Delta x$",
  "x": true
 },
 {
  "id": "c02",
  "k": "정의",
  "q": "극한(lim)이란?",
  "a": "$h$를 0에 한없이 가깝게 할 때($h\\neq0$) 식의 값이 다가가는 일정한 값.",
  "h": "$h=0$을 넣는 것이 아니다. 넣으면 $0/0$",
  "x": true
 },
 {
  "id": "c03",
  "k": "정의",
  "q": "미분계수 $f'(a)$의 정의는?",
  "a": "$f'(a)=\\lim_{h\\to0}\\frac{f(a+h)-f(a)}{h}$. $x=a$에서의 순간 변화율이고 점 $(a, f(a))$에서 접선의 기울기다.",
  "h": "미분계수 = 순간 변화율",
  "x": true
 },
 {
  "id": "c04",
  "k": "정의",
  "q": "도함수와 미분이란?",
  "a": "$x$마다 $f'(x)$를 짝지은 함수가 도함수 $f'(x)=\\frac{dy}{dx}$이고, 도함수를 구하는 것이 미분이다.",
  "h": "미분계수는 한 점의 값, 도함수는 함수",
  "x": true
 },
 {
  "id": "c05",
  "k": "사실",
  "q": "$f(x)=x^2$의 $x=3$에서 미분계수를 극한으로 구하면?",
  "a": "$\\frac{(3+h)^2-9}{h}=\\frac{6h+h^2}{h}=6+h\\to6$. 그래서 $f'(3)=6$.",
  "h": "$h\\neq0$이라 약분할 수 있다.",
  "x": true
 },
 {
  "id": "c06",
  "k": "법칙",
  "q": "거듭제곱·상수·상수배·합과 차의 미분 공식은?",
  "a": "$(x^n)'=nx^{n-1}$, $(c)'=0$, $(cf)'=cf'$, $(f\\pm g)'=f'\\pm g'$.",
  "h": "실수 $n$에서도($x>0$) 성립",
  "x": true
 },
 {
  "id": "c07",
  "k": "법칙",
  "q": "곱의 미분과 합성함수의 미분은?",
  "a": "$(fg)'=f'g+fg'$, $\\{f(g(x))\\}'=f'(g(x))g'(x)$.",
  "h": "고교 미적분 과목. $(e^{kx})'=ke^{kx}$도 합성함수의 미분으로 얻는다.",
  "x": true
 },
 {
  "id": "c08",
  "k": "사실",
  "q": "$|x|$가 $x=0$에서 미분 가능하지 않은 까닭은?",
  "a": "왼쪽 기울기는 $-1$, 오른쪽 기울기는 $+1$이라 극한이 하나로 정해지지 않는다.",
  "h": "꺾인 점은 확대해도 직선이 되지 않는다.",
  "x": true
 },
 {
  "id": "c09",
  "k": "법칙",
  "q": "위치·속도·가속도는 도함수로 어떻게 이어지는가?",
  "a": "$v=dx/dt$, $a=dv/dt$.",
  "h": "단위: m/s, $\\mathrm{m/s^2}$",
  "x": true
 },
 {
  "id": "c10",
  "k": "정의",
  "q": "부정적분과 적분 상수란?",
  "a": "$F'(x)=f(x)$인 $F(x)$가 $f(x)$의 부정적분이고 $\\int f(x)\\,dx=F(x)+C$로 쓴다. $C$가 적분 상수다.",
  "h": "상수는 미분하면 0이라 $C$는 정해지지 않는다.",
  "x": true
 },
 {
  "id": "c11",
  "k": "법칙",
  "q": "$\\int x^n\\,dx$와 $\\int x^{-1}dx$는?",
  "a": "$\\int x^n\\,dx=\\frac{x^{n+1}}{n+1}+C$ ($n\\neq-1$), $\\int x^{-1}dx=\\ln|x|+C$.",
  "h": "미분해서 확인한다.",
  "x": true
 },
 {
  "id": "c12",
  "k": "정의",
  "q": "정적분 $\\int_a^b f(x)\\,dx$의 정의(누적)는?",
  "a": "$[a, b]$를 $n$등분한 직사각형 넓이 $f(x_k)\\Delta x$의 합에서 $n\\to\\infty$인 극한. $x$축 아래는 음수로 센 넓이다.",
  "h": "고교 수학Ⅱ는 $F(b)-F(a)$를 정의로 쓴다.",
  "x": true
 },
 {
  "id": "c13",
  "k": "법칙",
  "q": "미적분의 기본 정리 2부(계산)는?",
  "a": "$f$가 $[a,b]$에서 연속이고 $F'=f$이면 $\\int_a^b f(x)\\,dx=\\Big[F(x)\\Big]_a^b=F(b)-F(a)$이다.",
  "h": "역도함수는 아무것이나 쓴다(상수 $C$는 지워진다). 1부는 $\\frac{d}{dx}\\int_a^xf(t)\\,dt=f(x)$",
  "t": "f가 [a,b]에서 연속이고 F'=f이면 int_a^b f(x)dx = F(b)-F(a)"
 },
 {
  "id": "c14",
  "k": "법칙",
  "q": "변위·속도 변화·이동 거리를 적분으로 쓰면?",
  "a": "변위 $s(t_2)-s(t_1)=\\int_{t_1}^{t_2}v\\,dt$, 속도 변화 $v(t_2)-v(t_1)=\\int_{t_1}^{t_2}a\\,dt$, 이동 거리 $=\\int_{t_1}^{t_2}|v|\\,dt$.",
  "h": "순변화 정리. 정적분은 부호 있는 넓이"
 },
 {
  "id": "c15",
  "k": "법칙",
  "q": "$a$가 일정할 때 $v=v_0+at$를 적분하면?",
  "a": "$x=x_0+v_0t+\\frac12at^2$. 적분 상수 $x_0$은 처음 위치다.",
  "h": "적분 상수는 처음 조건으로 정한다.",
  "x": true
 },
 {
  "id": "c16",
  "k": "정의",
  "q": "자연상수 $e$와 자연로그의 정의는?",
  "a": "$e=\\lim_{h\\to0}(1+h)^{1/h}=2.718\\cdots$. 밑이 $e$인 로그가 자연로그 $\\ln x=\\log_e x$이다.",
  "h": "$\\ln e=1$",
  "x": true
 },
 {
  "id": "c17",
  "k": "법칙",
  "q": "$e^x$, $e^{kx}$, $\\ln x$의 도함수는?",
  "a": "$(e^x)'=e^x$, $(e^{kx})'=ke^{kx}$, $(\\ln x)'=1/x$.",
  "h": "",
  "x": true
 },
 {
  "id": "c18",
  "k": "정의",
  "q": "미분방정식이란?",
  "a": "모르는 함수와 그 도함수의 관계식.",
  "h": "예: $dN/dt=kN$",
  "x": true
 },
 {
  "id": "c19",
  "k": "법칙",
  "q": "$dN/dt=kN$의 해와 푸는 법은?",
  "a": "양변을 $N$으로 나눠 $t$로 적분하면 $\\ln N=kt+C$, 곧 $N=N_0e^{kt}$ ($N_0$은 $t=0$의 값).",
  "h": "변수 분리. $k>0$이면 증가, $k<0$이면 감소",
  "x": true
 },
 {
  "id": "c20",
  "k": "법칙",
  "q": "반감기 $T$와 $k$의 관계는?",
  "a": "$T=\\ln2/|k|\\approx0.693/|k|$. 이때 $e^{kt}=(1/2)^{t/T}$로 [[e-history|#]]의 식과 같다.",
  "h": "$k$가 2배면 반감기는 절반",
  "x": true
 },
 {
  "id": "c21",
  "k": "법칙",
  "q": "배가 시간 $T_2$와 $k$의 관계는?",
  "a": "$T_2=\\ln2/k$ ($k>0$). $T_2$마다 2배가 된다.",
  "h": "$N=N_0\\cdot2^{t/T_2}$ ([[b-ecology|#]])",
  "x": true
 },
 {
  "id": "c22",
  "k": "상수",
  "q": "$\\ln2$와 $e$의 값은?",
  "a": "$\\ln2\\approx0.693$, $e\\approx2.718$.",
  "h": "",
  "x": true
 },
 {
  "id": "c23",
  "k": "상수",
  "q": "¹⁴C(반감기 5730년)의 $|k|$는?",
  "a": "$|k|=\\ln2/(5730\\ \\text{년})=1.21\\times10^{-4}$ /년.",
  "h": "$k$의 단위는 (시간)$^{-1}$",
  "x": true
 },
 {
  "id": "c24",
  "k": "사실",
  "q": "$dN/dt=kN$이 맞는 조건은?",
  "a": "$N$이 커서 매끄러운 함수로 볼 때. 자원이 한정되면 [[b-ecology|#]]의 로지스틱 식을 따르고 $N\\ll K$일 때만 $dN/dt\\approx rN$이다.",
  "h": "원자 하나의 붕괴는 확률([[p-nuclear|#]])",
  "x": true
 },
 {
  "id": "c25",
  "k": "사실",
  "q": "지수적 감소에서 같은 시간마다 일정한 것은?",
  "a": "줄어드는 비율(배수). 줄어드는 양은 양이 줄수록 작아진다.",
  "h": "반감기마다 절반",
  "x": true
 },
 {
  "id": "c26",
  "k": "용어",
  "q": "평균 변화율",
  "a": "平均變化率 · average rate of change",
  "h": "率 비율 률",
  "x": true
 },
 {
  "id": "c27",
  "k": "용어",
  "q": "극한",
  "a": "極限 · limit",
  "h": "極 다할 극, 限 한할 한",
  "x": true
 },
 {
  "id": "c28",
  "k": "용어",
  "q": "미분계수",
  "a": "微分係數 · derivative at a point",
  "h": "係 맬 계. 사전 표제어는 '미분^계수'. 옛 영어 이름 differential coefficient.",
  "x": true
 },
 {
  "id": "c29",
  "k": "용어",
  "q": "순간 변화율",
  "a": "瞬間變化率 · instantaneous rate of change",
  "h": "瞬 눈 깜짝일 순",
  "x": true
 },
 {
  "id": "c30",
  "k": "용어",
  "q": "도함수",
  "a": "導函數 · derivative",
  "h": "導 인도할 도, 函 함 함. ≒유도 함수",
  "x": true
 },
 {
  "id": "c31",
  "k": "용어",
  "q": "미분",
  "a": "微分 · differentiation",
  "h": "微 작을 미, 分 나눌 분",
  "x": true
 },
 {
  "id": "c32",
  "k": "용어",
  "q": "부정적분",
  "a": "不定積分 · indefinite integral",
  "h": "不定: 정해지지 않음. 積 쌓을 적",
  "x": true
 },
 {
  "id": "c33",
  "k": "용어",
  "q": "적분 상수",
  "a": "積分常數 · constant of integration",
  "h": "常 항상 상, 數 셀 수",
  "x": true
 },
 {
  "id": "c34",
  "k": "용어",
  "q": "정적분",
  "a": "定積分 · definite integral",
  "h": "定 정할 정"
 },
 {
  "id": "c35",
  "k": "용어",
  "q": "미적분의 기본 정리",
  "a": "微積分의 基本 定理 · fundamental theorem of calculus",
  "h": "定理: 증명된 명제"
 },
 {
  "id": "c36",
  "k": "용어",
  "q": "자연상수",
  "a": "自然常數 · Euler's number",
  "h": "기호 $e$. 사전 표제어 아님",
  "x": true
 },
 {
  "id": "c37",
  "k": "용어",
  "q": "자연로그",
  "a": "自然log · natural logarithm",
  "h": "기호 ln",
  "x": true
 },
 {
  "id": "c38",
  "k": "용어",
  "q": "미분방정식",
  "a": "微分方程式 · differential equation",
  "h": "程 한도 정, 式 법 식",
  "x": true
 },
 {
  "id": "c39",
  "k": "용어",
  "q": "배가 시간",
  "a": "倍加時間 · doubling time",
  "h": "倍 곱 배, 加 더할 가",
  "x": true
 },
 {
  "id": "c40",
  "k": "용어",
  "q": "변수 분리",
  "a": "變數分離 · separation of variables",
  "h": "離 떠날 리",
  "x": true
 },
 {
  "id": "c41",
  "k": "정의",
  "q": "구간의 분할과 소구간이란?",
  "a": "닫힌구간 $[a,b]$ 안에서 $a=x_0<x_1<\\cdots<x_n=b$로 고른 점들의 집합 $P$가 구간의 분할이고, 그 점들이 나눈 $[x_{k-1},x_k]$가 $k$번째 소구간(폭 $\\Delta x_k=x_k-x_{k-1}$)이다.",
  "h": "집합의 분할([[f-set|#]])과 다르다. 이웃한 소구간은 끝점을 함께 가진다.",
  "t": "a=x0<x1<...<xn=b로 고른 점들의 집합"
 },
 {
  "id": "c42",
  "k": "정의",
  "q": "상합과 하합이란?",
  "a": "분할의 소구간마다 $f$의 최댓값을 높이로 한 직사각형 넓이의 합이 상합, 최솟값을 높이로 한 합이 하합이다.",
  "h": "감소함수는 상합이 왼쪽 끝값, 하합이 오른쪽 끝값(증가함수는 반대). $f\\ge0$이면 하합 ≤ 넓이 ≤ 상합."
 },
 {
  "id": "c43",
  "k": "정의",
  "q": "분할 $P$의 노름 $\\|P\\|$이란?",
  "a": "$P$의 소구간 폭 가운데 가장 큰 값.",
  "h": "$\\{0,1.2,1.5,2.3,2.6,3\\}$의 노름은 1.2"
 },
 {
  "id": "c44",
  "k": "정의",
  "q": "리만 합이란?",
  "a": "$[a,b]$의 분할 $P$의 소구간마다 한 점 $c_k$를 골라 만든 합 $\\sum_{k=1}^{n}f(c_k)\\,\\Delta x_k$.",
  "h": "상합·하합·끝값 어림·중점 어림은 모두 $c_k$를 특별히 고른 리만 합이다.",
  "t": "소구간마다 한 점 c_k를 골라 만든 합 sum f(c_k) Δx_k"
 },
 {
  "id": "c45",
  "k": "정의",
  "q": "정적분 $\\int_a^b f(x)\\,dx$의 정의는?",
  "a": "$\\|P\\|\\to0$일 때 분할과 $c_k$를 어떻게 고르든 리만 합 $\\sum f(c_k)\\,\\Delta x_k$가 다가가는 한 수 $J$.",
  "h": "$n$만이 아니라 분할과 점의 모든 선택에 걸친 극한",
  "t": "노름이 0으로 갈 때 분할과 c_k를 어떻게 고르든 리만 합이 다가가는 한 수"
 },
 {
  "id": "c46",
  "k": "정의",
  "q": "$f$가 $[a,b]$에서 적분가능하다는 것은?",
  "a": "$f$의 $[a,b]$에서의 정적분, 곧 리만 합의 극한이 존재하는 것.",
  "h": "∫ 안의 $f$가 피적분 함수. 적분 변수는 다른 글자로 바꿔도 값이 같다."
 },
 {
  "id": "c47",
  "k": "법칙",
  "q": "$[a,b]$에서 적분가능함이 보장되는 함수는?",
  "a": "$[a,b]$에서 연속이거나, 뛰는 불연속점이 유한 개뿐인 함수.",
  "h": "유리수에서 1, 무리수에서 0인 함수는 상합이 늘 1, 하합이 늘 0이라 적분가능하지 않다."
 },
 {
  "id": "c48",
  "k": "법칙",
  "q": "$\\sum_{k=1}^{n}k^2$과 $\\sum_{k=1}^{n}k^3$은?",
  "a": "$\\frac{n(n+1)(2n+1)}{6}$, $\\left(\\frac{n(n+1)}{2}\\right)^2$.",
  "h": "$\\sum_{k=1}^nk=\\frac{n(n+1)}2$, $\\sum_{k=1}^nc=nc$. 귀납법으로 증명한다.",
  "t": "n(n+1)(2n+1)/6, (n(n+1)/2)^2"
 },
 {
  "id": "c49",
  "k": "법칙",
  "q": "같은 폭으로 나눈 오른쪽 끝 리만 합으로 정적분을 구하는 식은?",
  "a": "$f$가 적분가능하면 $\\int_a^b f(x)\\,dx=\\lim_{n\\to\\infty}\\sum_{k=1}^{n}f\\!\\left(a+k\\frac{b-a}{n}\\right)\\frac{b-a}{n}$.",
  "h": "$a=0$, $b=1$이면 $\\lim\\frac1n\\sum f(\\frac kn)=\\int_0^1f(x)\\,dx$",
  "t": "lim n->inf sum_{k=1}^n f(a+k(b-a)/n) (b-a)/n"
 },
 {
  "id": "c50",
  "k": "법칙",
  "q": "$\\int_a^b c\\,dx$, $\\int_a^b x\\,dx$, $\\int_a^b x^2\\,dx$는?",
  "a": "$c(b-a)$, $\\frac{b^2-a^2}{2}$, $\\frac{b^3-a^3}{3}$.",
  "h": "리만 합의 극한과 합 공식에서 나온다. $\\int_a^bx^3dx=\\frac{b^4-a^4}4$",
  "t": "c(b-a), (b^2-a^2)/2, (b^3-a^3)/3"
 },
 {
  "id": "c51",
  "k": "법칙",
  "q": "정적분의 순서·폭 0·구간 덧셈 규칙은?",
  "a": "$\\int_b^af\\,dx=-\\int_a^bf\\,dx$, $\\int_a^af\\,dx=0$, $\\int_a^bf\\,dx+\\int_b^cf\\,dx=\\int_a^cf\\,dx$.",
  "h": "처음 둘은 정의로 정한 약속이다. 상수배와 합·차도 정적분 밖으로 나온다."
 },
 {
  "id": "c52",
  "k": "법칙",
  "q": "최대·최소 부등식과 대소 규칙은?",
  "a": "$[a,b]$에서 $m\\le f\\le M$이면 $m(b-a)\\le\\int_a^bf\\,dx\\le M(b-a)$이다. $f\\ge g$이면 $\\int_a^bf\\,dx\\ge\\int_a^bg\\,dx$이다.",
  "h": "$f\\ge0$이면 $\\int_a^bf\\,dx\\ge0$. 예: $\\int_0^1\\sin x\\,dx\\le\\int_0^1x\\,dx=\\frac12$"
 },
 {
  "id": "c53",
  "k": "정의",
  "q": "곡선 아래 넓이는 정적분으로 어떻게 정의하고, 정적분은 넓이와 어떻게 다른가?",
  "a": "$f\\ge0$이고 적분가능하면 곡선 $y=f(x)$ 아래 $[a,b]$ 위의 넓이를 $\\int_a^bf(x)\\,dx$로 정의한다. 일반적으로 정적분은 (가로축 위 넓이) − (가로축 아래 넓이)이다.",
  "h": "정적분은 부호 있는 넓이"
 },
 {
  "id": "c54",
  "k": "정의",
  "q": "함수의 평균값의 정의는?",
  "a": "$f$가 $[a,b]$에서 적분가능할 때 $\\operatorname{av}(f)=\\frac{1}{b-a}\\int_a^bf(x)\\,dx$.",
  "h": "같은 폭 위에 같은 넓이를 가진 직사각형의 높이. 2부로 $\\frac{F(b)-F(a)}{b-a}$",
  "t": "av(f) = 1/(b-a) * int_a^b f(x) dx"
 },
 {
  "id": "c55",
  "k": "법칙",
  "q": "적분의 평균값 정리는?",
  "a": "$f$가 $[a,b]$에서 연속이면 $f(c)=\\frac{1}{b-a}\\int_a^bf(x)\\,dx$인 $c$가 $[a,b]$에 적어도 하나 있다.",
  "h": "연속이 아니면 평균값을 갖지 않을 수 있다(계단 함수).",
  "t": "f가 [a,b]에서 연속이면 f(c) = 평균값인 c가 [a,b]에 있다"
 },
 {
  "id": "c56",
  "k": "법칙",
  "q": "미적분의 기본 정리 1부는?",
  "a": "$f$가 $[a,b]$에서 연속이면 $F(x)=\\int_a^xf(t)\\,dt$는 $(a,b)$에서 미분가능하고 $F'(x)=f(x)$이다.",
  "h": "넓이가 느는 빠르기 = 그 자리의 높이",
  "t": "f가 [a,b]에서 연속이면 d/dx int_a^x f(t)dt = f(x)"
 },
 {
  "id": "c57",
  "k": "법칙",
  "q": "$\\frac{d}{dx}\\int_a^{u(x)}f(t)\\,dt$와 $\\frac{d}{dx}\\int_x^bf(t)\\,dt$는?",
  "a": "$f(u(x))\\,u'(x)$와 $-f(x)$이다($f$ 연속, $u$ 미분가능).",
  "h": "두 끝이 모두 변수이면 $f(v(x))v'(x)-f(u(x))u'(x)$ (라이프니츠 규칙)",
  "t": "f(u(x)) u'(x), -f(x)"
 },
 {
  "id": "c58",
  "k": "법칙",
  "q": "순변화 정리는?",
  "a": "$F'$이 $[a,b]$에서 연속이면 $\\int_a^bF'(x)\\,dx=F(b)-F(a)$이다. 변화율의 정적분은 그동안의 순변화이다.",
  "h": "한계비용을 적분하면 그사이 늘어난 비용",
  "t": "int_a^b F'(x) dx = F(b) - F(a)"
 },
 {
  "id": "c59",
  "k": "사실",
  "q": "그래프와 가로축 사이의 총넓이를 구하는 법은?",
  "a": "$f$가 0이 되는 점에서 구간을 나누고, 조각마다 정적분을 구해 그 절댓값을 더한다.",
  "h": "$x^2-1$을 $[0,2]$에서: 정적분 $\\frac23$, 총넓이 2"
 },
 {
  "id": "c60",
  "k": "법칙",
  "q": "치환 적분의 식은?",
  "a": "$u=g(x)$로 놓으면 $\\int f(g(x))\\,g'(x)\\,dx=\\int f(u)\\,du=F(g(x))+C$이다($F'=f$).",
  "h": "연쇄 법칙을 거꾸로 읽은 것. $du=g'(x)\\,dx$, 남은 $x$도 $u$로 바꾼다.",
  "t": "int f(g(x)) g'(x) dx = int f(u) du = F(g(x)) + C"
 },
 {
  "id": "c61",
  "k": "법칙",
  "q": "정적분에서 치환하면 끝은 어떻게 되는가?",
  "a": "$g'$이 $[a,b]$에서 연속이고 $f$가 $g$의 치역에서 연속이면 $\\int_a^bf(g(x))\\,g'(x)\\,dx=\\int_{g(a)}^{g(b)}f(u)\\,du$이다.",
  "h": "원래 끝을 쓰려면 $x$로 되돌린 역도함수에 넣는다.",
  "t": "int_a^b f(g(x)) g'(x) dx = int_{g(a)}^{g(b)} f(u) du"
 },
 {
  "id": "c62",
  "k": "법칙",
  "q": "짝함수와 홀함수의 $\\int_{-a}^af(x)\\,dx$는?",
  "a": "$f$가 $[-a,a]$에서 연속일 때, 짝함수이면 $2\\int_0^af(x)\\,dx$, 홀함수이면 0이다.",
  "h": "$u=-x$로 치환해 보인다. $\\tan x\\sec^2x$는 홀함수."
 },
 {
  "id": "c63",
  "k": "정의",
  "q": "두 곡선 사이의 넓이는?",
  "a": "$f$, $g$가 $[a,b]$에서 연속이고 $f(x)\\ge g(x)$이면 $\\int_a^b[f(x)-g(x)]\\,dx$이다. 경계가 $x=f(y)$ 꼴이면 (오른쪽) − (왼쪽)을 $y$로 적분한다.",
  "h": "위아래가 바뀌면 만나는 점에서 나눈다. 일반적으로 $\\int_a^b|f-g|\\,dx$",
  "t": "f>=g이면 int_a^b (f(x)-g(x)) dx"
 },
 {
