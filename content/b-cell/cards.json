[
  {
    "id": "c01",
    "k": "정의",
    "q": "원핵세포의 정의는?",
    "a": "핵막이 없어 DNA가 세포질에 있고, 막으로 싸인 세포 소기관이 없는 세포.",
    "h": "세균·고세균의 세포. 리보솜은 있다."
  },
  {
    "id": "c02",
    "k": "정의",
    "q": "진핵세포의 정의는?",
    "a": "핵막으로 싸인 핵과 막으로 싸인 세포 소기관을 가진 세포.",
    "h": "원생생물·균류·식물·동물의 세포."
  },
  {
    "id": "c03",
    "k": "사실",
    "q": "모든 세포가 공통으로 가진 네 가지는?",
    "a": "세포막, 세포질, DNA, 리보솜.",
    "h": "원핵세포에도 리보솜이 있다."
  },
  {
    "id": "c04",
    "k": "정의",
    "q": "세포질의 정의는?",
    "a": "세포막 안에서 핵을 뺀 부분.",
    "h": ""
  },
  {
    "id": "c05",
    "k": "정의",
    "q": "세포 소기관의 정의는?",
    "a": "세포 안에서 특정한 일을 맡도록 분화된 구조.",
    "h": "캠벨·새다바는 막으로 싸인 것만 organelle로 보고, 한국 교과서는 리보솜·중심체도 넣는다."
  },
  {
    "id": "c06",
    "k": "상수",
    "q": "원핵세포와 진핵세포의 대표 크기는?",
    "a": "원핵세포 약 1~10 μm, 진핵세포 약 10~100 μm.",
    "h": "진핵세포가 약 10배 크다."
  },
  {
    "id": "c07",
    "k": "분류",
    "q": "원핵세포로 된 생물과 진핵세포로 된 생물은?",
    "a": "원핵: 세균, 고세균. 진핵: 원생생물, 균류, 식물, 동물.",
    "h": "13번의 3역과 맞춰 외운다."
  },
  {
    "id": "c08",
    "k": "분류",
    "q": "동물 세포와 식물 세포의 구조 차이는?",
    "a": "식물 세포에는 있고 동물 세포에는 없음: 세포벽, 엽록체, 크게 발달한 액포. 주로 동물 세포에 있음: 중심체.",
    "h": "엽록체는 광합성하는 세포에만 있다(양파 비늘잎·뿌리 세포에는 없음)."
  },
  {
    "id": "c09",
