[
 {
  "id": "c01",
  "k": "정의",
  "q": "상대 연령의 정의는?",
  "a": "지층·암석의 생성이나 지질 사건의 앞뒤 순서.",
  "h": "'몇 년 전'인지는 모른다. 그것은 절대 연령."
 },
 {
  "id": "c02",
  "k": "법칙",
  "q": "동일 과정의 원리(동일 과정설)는?",
  "a": "지금 일어나는 지질 작용이 과거에도 같은 방식으로 일어났다. 그래서 현재로 과거를 해석한다.",
  "h": "'현재는 과거를 여는 열쇠'"
 },
 {
  "id": "c03",
  "k": "법칙",
  "q": "수평 퇴적의 원리와 지층 누중의 법칙은?",
  "a": "퇴적물은 처음에 수평으로 쌓인다. 뒤집히지 않은 지층에서는 아래층이 먼저 쌓였다.",
  "h": "기울거나 휜 지층은 쌓인 뒤 변형된 것. 마더텅은 '수평 퇴적의 법칙'이라 쓴다."
 },
 {
  "id": "c04",
  "k": "법칙",
  "q": "관입의 법칙과, 관입과 분출을 가리는 단서는?",
  "a": "관입한 화성암은 뚫린 암석보다 젊다. 위층까지 구워졌거나 포획암이 있으면 관입, 위층 바닥에 화성암 조각이 있으면 분출 뒤 퇴적.",
  "h": "관입이면 화성암이 위층보다 젊고, 분출이면 위층이 화성암보다 젊다."
 },
 {
  "id": "c05",
  "k": "사실",
  "q": "부정합이 생기는 순서와 부정합면 위에 흔한 것은?",
  "a": "퇴적 → 융기 → 침식 → 침강 → 퇴적. 부정합면 위에 기저 역암.",
  "h": "부정합의 법칙: 부정합면 위아래 사이에 긴 시간 공백이 있다."
 },
 {
  "id": "c06",
  "k": "분류",
  "q": "부정합의 세 종류는?",
  "a": "평행 부정합(위아래 층이 나란함), 경사 부정합(아래층이 기욺), 난정합(아래가 심성암·변성암).",
  "h": ""
 },
 {
  "id": "c07",
  "k": "분류",
  "q": "퇴적 구조 네 가지의 모양과 환경은?",
  "a": "사층리: 층 안의 줄이 비스듬함, 한쪽으로 흐르는 물·바람 / 점이 층리: 위로 갈수록 알갱이가 작아짐, 깊은 바다·호수 / 연흔: 물결 자국, 얕은 물 밑 / 건열: 진흙이 말라 갈라짐, 건조한 곳.",
  "h": ""
 },
 {
  "id": "c08",
  "k": "사실",
  "q": "퇴적 구조로 지층의 위쪽을 가리는 법은?",
  "a": "점이 층리는 굵은 쪽이 아래, 연흔은 뾰족한 마루가 위, 건열은 쐐기의 넓은 쪽이 위.",
  "h": "사층리는 줄이 아래에서 휘어 붙고 위에서 잘린다."
 },
 {
  "id": "c09",
  "k": "정의",
  "q": "지층 대비의 두 방법과 건층은?",
  "a": "암석의 특징으로 하는 암상 대비와 화석으로 하는 화석 대비. 건층(열쇠층)은 응회암층처럼 짧은 시간에 넓게 쌓여 기준이 되는 층.",
  "h": "화석 대비는 같은 표준 화석이 나오는 층을 잇는다."
 },
 {
  "id": "c10",
  "k": "분류",
  "q": "표준 화석과 시상 화석은 각각 무엇을 알려 주고, 어떤 생물이어야 하나?",
  "a": "표준 화석: 시대. 짧은 기간 넓은 지역에 많이 산 생물. 시상 화석: 살던 환경. 특정 환경에서만 산 생물(예: 산호).",
  "h": "시상 화석은 생존 기간이 길고 환경 변화에 민감한 생물이 좋다(마더텅)."
 },
 {
  "id": "c11",
  "k": "정의",
  "q": "절대 연령의 정의는?",
  "a": "암석이 생기거나 사건이 일어난 때를 '몇 년 전'이라는 수치로 나타낸 것.",
  "h": "방사성 동위 원소의 반감기로 잰다."
 },
 {
  "id": "c12",
  "k": "정의",
  "q": "반감기의 정의는?",
  "a": "방사성 동위 원소(모원소)의 양이 처음의 절반으로 주는 데 걸리는 시간.",
  "h": "온도·압력에 사실상 상관없이 일정하다."
 },
 {
  "id": "c13",
  "k": "법칙",
  "q": "모원소 양의 붕괴식과 기호의 뜻은?",
  "a": "$N=N_0(1/2)^{t/T}$. $N_0$: 처음 양, $N$: 시간 $t$ 뒤 남은 양, $T$: 반감기.",
  "h": "로그로 풀면 $t=T\\log(N_0/N)/\\log2$."
 },
 {
  "id": "c14",
  "k": "사실",
  "q": "반감기가 $n$번 지나면 모원소 : 자원소는?",
  "a": "$1:(2^n-1)$. 1번 1 : 1, 2번 1 : 3, 3번 1 : 7.",
  "h": "모원소는 $1/2^n$으로 0에 다가갈 뿐이다."
 },
 {
  "id": "c15",
  "k": "상수",
  "q": "¹⁴C의 자원소와 반감기, 쓰임은?",
  "a": "¹⁴N, 5730년. 생물이 죽은 뒤부터 줄어 수만 년 안의 생물 유해의 나이를 잰다.",
  "h": "최신 측정값은 약 5700년이다(교재마다 5700·5715·5730년)."
 },
 {
  "id": "c16",
  "k": "상수",
  "q": "⁴⁰K와 ²³⁸U의 자원소와 반감기는?",
  "a": "⁴⁰K → ⁴⁰Ar 약 13억 년, ²³⁸U → ²⁰⁶Pb 약 45억 년.",
  "h": "실제 ⁴⁰K는 약 89 %가 ⁴⁰Ca, 약 11 %만 ⁴⁰Ar이 된다. 교과서 문제는 모두 ⁴⁰Ar로 본다."
 },
 {
  "id": "c17",
  "k": "사실",
  "q": "방사성 연령이 맞으려면 필요한 조건은?",
  "a": "처음 자원소 양을 알고, 그 뒤 모원소·자원소가 드나들지 않아야 한다.",
  "h": "아르곤은 기체라 암석이 달궈지면 빠져 나이가 젊게 나온다."
 },
 {
  "id": "c18",
  "k": "사실",
  "q": "절대 연령을 바로 재는 암석과, 퇴적층의 나이를 정하는 법은?",
  "a": "화성암(광물이 결정을 이룬 때), 변성암(변성된 때). 퇴적층은 위아래나 뚫은 화성암·응회암의 나이로 범위를 좁힌다.",
  "h": "퇴적암 알갱이는 더 오래된 암석에서 왔다(30억 년 퇴적암 속 44억 년 지르콘)."
 },
 {
  "id": "c19",
  "k": "분류",
  "q": "지질 시대의 구분 단위와 누대 셋은?",
  "a": "누대 – 대 – 기. 시생 누대·원생 누대(선캄브리아 시대), 현생 누대(고생대·중생대·신생대).",
  "h": "국제 연대표는 약 40억 년 전 이전을 명왕 누대로 따로 둔다."
 },
 {
  "id": "c20",
  "k": "상수",
  "q": "지구의 나이와 원생 누대·고생대·중생대·신생대가 시작한 때는?",
  "a": "약 46억 년. 25억, 5.41억, 2.52억, 0.66억 년 전.",
  "h": "국제 연대표(2022~)는 고생대 시작을 약 5.39억 년 전으로 쓴다."
 },
 {
  "id": "c21",
  "k": "분류",
  "q": "고생대·중생대·신생대의 기를 차례로?",
  "a": "캄브리아–오르도비스–실루리아–데본–석탄–페름기 / 트라이아스–쥐라–백악기 / 팔레오–네오–제4기.",
  "h": "캄·오·실·데·석·페 / 트·쥐·백 / 팔·네·제4"
 },
 {
  "id": "c22",
  "k": "분류",
  "q": "시대별 대표 생물은?",
  "a": "시생 누대 스트로마톨라이트, 원생 누대 말 에디아카라 동물군, 고생대 삼엽충·필석·방추충, 중생대 공룡·암모나이트, 신생대 화폐석·매머드.",
  "h": "식물은 양치식물(고생대) → 겉씨식물(중생대) → 속씨식물(신생대)."
 },
 {
  "id": "c23",
  "k": "사실",
  "q": "5대 대멸종은?",
  "a": "오르도비스기 말, 데본기 후기, 페름기 말, 트라이아스기 말, 백악기 말.",
  "h": "가장 큰 것은 페름기 말. 교과서는 흔히 '데본기 말'이라 쓴다."
 },
 {
  "id": "c24",
  "k": "사실",
  "q": "페름기 말 대멸종의 규모와 겹친 사건은?",
  "a": "해양 생물 종의 90 % 이상과 삼엽충이 사라졌다. 판게아 형성·시베리아의 거대한 용암 분출과 겹친다. 고생대/중생대 경계.",
  "h": "약 2.52억 년 전. 캠벨은 해양 동물 종의 약 96 %로 적는다."
 },
 {
  "id": "c25",
  "k": "사실",
  "q": "백악기 말 대멸종에서 사라진 생물과 원인의 증거는?",
  "a": "공룡·암모나이트. 이리듐이 많은 경계층과 멕시코의 충돌 구덩이가 소행성 충돌을 가리킨다. 중생대/신생대 경계.",
  "h": "약 0.66억 년 전."
 },
