[
 {
  "id": "c01",
  "k": "정의",
  "q": "거듭제곱 $a^n$에서 밑과 지수란?",
  "a": "$a$를 $n$번 곱한 것이 거듭제곱 $a^n$이다. $a$를 밑, $n$을 지수라 한다.",
  "h": "지수 = 곱한 횟수"
 },
 {
  "id": "c02",
  "k": "법칙",
  "q": "지수법칙 네 가지와 성립 조건은?",
  "a": "$a^ma^n=a^{m+n}$, $a^m\\div a^n=a^{m-n}$, $(a^m)^n=a^{mn}$, $(ab)^n=a^nb^n$. 지수가 실수일 때는 $a,\\,b>0$.",
  "h": "곱하면 지수를 더하고, 나누면 뺀다."
 },
 {
  "id": "c03",
  "k": "법칙",
  "q": "$a^0$, $a^{-n}$, $a^{1/n}$의 값과 그렇게 정한 까닭은?",
  "a": "$a^0=1$, $a^{-n}=1/a^n$, $a^{1/n}=\\sqrt[n]{a}$. 지수법칙이 0·음수·분수 지수에서도 그대로 성립하도록 정했다.",
  "h": "$a^n\\div a^n=a^0=1$"
 },
 {
  "id": "c04",
  "k": "정의",
  "q": "과학적 표기법의 꼴과 조건은?",
  "a": "$a\\times10^n$ ($1\\le a<10$, $n$은 정수).",
  "h": "$0.00052=5.2\\times10^{-4}$"
 },
 {
  "id": "c05",
  "k": "법칙",
  "q": "과학적 표기법으로 쓴 수의 곱셈·나눗셈·덧셈은 어떻게 하는가?",
  "a": "곱셈: 앞수끼리 곱하고 지수를 더한다. 나눗셈: 앞수끼리 나누고 지수를 뺀다. 덧셈·뺄셈: 지수를 맞춘 뒤 앞수끼리 한다. 끝에 앞수를 1 이상 10 미만으로 고친다.",
  "h": "$18\\times10^{-3}=1.8\\times10^{-2}$"
 },
 {
  "id": "c06",
  "k": "정의",
  "q": "로그 $\\log_a x$의 정의와 조건은?",
  "a": "$x=a^y$일 때 $y=\\log_a x$이다. 밑은 $a>0$, $a\\neq1$, 진수는 $x>0$.",
  "h": "로그는 '몇 제곱인가'를 묻는다."
 },
 {
  "id": "c07",
  "k": "정의",
  "q": "상용로그란?",
  "a": "밑이 10인 로그. $\\log x$로 쓰며 $y=\\log x \\iff x=10^y$.",
  "h": ""
 },
 {
  "id": "c08",
  "k": "법칙",
  "q": "로그의 성질 세 가지는?",
  "a": "$\\log xy=\\log x+\\log y$, $\\log\\frac{x}{y}=\\log x-\\log y$, $\\log x^n=n\\log x$.",
  "h": "지수법칙을 로그로 옮긴 것"
 },
 {
  "id": "c09",
  "k": "상수",
  "q": "$\\log2$와 $\\log3$의 값은?",
  "a": "$\\log2\\approx0.301$, $\\log3\\approx0.477$.",
  "h": "$\\log5=1-\\log2\\approx0.699$, $\\log6\\approx0.778$"
 },
 {
  "id": "c10",
  "k": "사실",
  "q": "$\\log1$, $\\log10^n$의 값과, 0이나 음수의 로그는?",
  "a": "$\\log1=0$, $\\log10^n=n$. 0과 음수의 로그는 정의되지 않는다(진수는 양수).",
  "h": "$10^y$는 언제나 양수다."
 },
 {
  "id": "c11",
  "k": "정의",
  "q": "로그 척도란?",
  "a": "양의 로그값으로 매긴 척도. 양이 10배가 될 때마다 값이 일정하게 커진다.",
  "h": "간격이 '얼마 더'가 아니라 '몇 배'를 뜻한다."
 },
 {
  "id": "c12",
  "k": "정의",
  "q": "pH의 정의는?",
  "a": "$\\mathrm{pH}=-\\log[\\mathrm{H^+}]$. $[\\mathrm{H^+}]$는 수소 이온 농도(mol/L)의 수치이다.",
  "h": "산·농도는 [[c-solution|#]]·[[c-acid|#]]에서 다룬다."
 },
 {
  "id": "c13",
  "k": "사실",
  "q": "pH가 1 낮아지면 $[\\mathrm{H^+}]$는? 2 낮아지면?",
  "a": "1 낮으면 10배, 2 낮으면 100배가 된다.",
  "h": "부호가 음이라 $[\\mathrm{H^+}]$가 클수록 pH는 작다."
 },
 {
  "id": "c14",
  "k": "정의",
  "q": "소리 세기 준위 $L$의 정의와 기준 세기 $I_0$는?",
  "a": "$L=10\\log(I/I_0)$ dB. $I$는 소리 세기(W/m²), $I_0=10^{-12}\\ \\mathrm{W/m^2}$는 겨우 들리는 세기(0 dB)이다.",
  "h": "단위는 데시벨(dB)"
 },
 {
  "id": "c15",
  "k": "사실",
  "q": "소리 세기가 10배, 2배, 100배가 되면 $L$은 얼마나 커지는가?",
  "a": "10배: 10 dB, 2배: 약 3 dB, 100배: 20 dB.",
  "h": "$10\\log2=3.01$이라 3 dB는 근사"
 },
 {
  "id": "c16",
  "k": "사실",
  "q": "지진 규모가 1 커지면 진폭과 에너지는? 2 커지면 에너지는?",
  "a": "진폭 10배, 에너지 약 32배($10^{1.5}\\approx31.6$). 2 커지면 에너지 $10^3=1000$배.",
  "h": "규모는 최대 진폭 하나로 재므로 '세기 $\\propto$ 진폭$^2$'으로 셈한 100배와 다르다."
 },
 {
  "id": "c17",
  "k": "분류",
  "q": "지진의 규모와 진도의 차이는?",
  "a": "규모: 지진이 방출한 에너지의 크기로 지진마다 하나. 진도: 한 장소의 흔들림을 느낌이나 피해로 매긴 등급으로 장소마다 다르다.",
  "h": "같은 지진이라도 진도는 곳마다 다르다."
 },
 {
  "id": "c18",
  "k": "사실",
  "q": "한국 기상청의 진도 등급은?",
  "a": "Ⅰ~Ⅻ의 12단계이다.",
  "h": "진도는 로그 척도가 아니라 등급이다."
 },
 {
  "id": "c19",
  "k": "정의",
  "q": "페르미 추정이란?",
  "a": "정확한 자료 없이 구하려는 양을 어림할 수 있는 양들의 곱·나눗셈으로 쪼개어 크기(자릿수)를 구하는 방법.",
  "h": "답은 보통 10배 안쪽에서 맞는다."
 },
 {
  "id": "c20",
  "k": "법칙",
  "q": "페르미 추정의 네 단계는?",
  "a": "① 식으로 쪼갠다 ② 각 양을 가정을 밝혀 어림한다 ③ 과학적 표기법으로 계산한다 ④ 자릿수로 답하고 점검한다.",
  "h": "가정을 적어야 틀린 가정을 찾는다."
 },
 {
  "id": "c21",
  "k": "법칙",
  "q": "수 $a\\times10^n$의 자릿수를 정하는 법은?",
  "a": "$a<\\sqrt{10}\\approx3.16$이면 $10^n$, 그 이상이면 $10^{n+1}$.",
  "h": "$4\\times10^7$의 자릿수는 $10^8$"
 },
 {
  "id": "c22",
  "k": "법칙",
  "q": "위아래 끝만 아는 양을 어림할 때 고르는 값은?",
  "a": "두 끝의 곱의 제곱근(로그 척도의 가운데). 1과 100 사이면 50이 아니라 10.",
  "h": "1~10 km면 약 3 km"
 },
 {
  "id": "c23",
  "k": "사실",
  "q": "로그값의 유효숫자는 어떻게 세는가?",
  "a": "소수점 아래 숫자만 센다. 정수 부분은 10의 몇 제곱인지를 나타낸다.",
  "h": "$[\\mathrm{H^+}]=2.0\\times10^{-4}$이면 pH 3.70"
 },
